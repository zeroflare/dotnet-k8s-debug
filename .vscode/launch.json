{
  "version": "2.0.0",
  "configurations": [
    {
      "name": "MyApi: 本機",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MyApi/bin/Debug/net10.0/MyApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MyApi",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "MyApi: Attach K8s (SSH)",
      "type": "coreclr",
      "request": "attach",
      "processId": 1,
      "justMyCode": false,
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "ssh",
        "pipeArgs": [
          "-T",
          "-i",
          "${workspaceFolder}/scripts/p.key",
          "-o",
          "IdentitiesOnly=yes",
          "-o",
          "LogLevel=ERROR",
          "github@136.119.103.123",
          "kubectl",
          "exec",
          "-i",
          "deploy/my-app-deploy",
          "-c",
          "my-app",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "windows": {
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder}",
          "pipeProgram": "${env:WINDIR}\\System32\\OpenSSH\\ssh.exe",
          "pipeArgs": [
            "-T",
            "-i",
            "${workspaceFolder}/scripts/p.key",
            "-o",
            "BatchMode=yes",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "github@136.119.103.123",
            "kubectl",
            "exec",
            "-i",
            "deploy/my-app-deploy",
            "-c",
            "my-app",
            "--"
          ],
          "debuggerPath": "/vsdbg/vsdbg",
          "quoteArgs": false
        }
      },
      "sourceFileMap": {
        "/src/MyApi": "${workspaceFolder}/src/MyApi"
      }
    }
  ]
}
